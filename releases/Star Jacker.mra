        <dip name="Cabinet" bits="8" ids="Upright,Cocktail"/>
        <dip name="Lives" bits="9,10" ids="Infinite,5,4,3"/>
        <dip name="DEF_STR (Bonus_Life )" bits="11,13" ids="50k+ then every 60k,Every 50k,40k+ then every 50k,Every 40k,30k+ then every 40k,Every 30k,20k+ then every 30k,Every 20k"/>
        <dip name="Difficulty" bits="14,15" ids="Hardest,Hard,Medium,Easy"/>
    </switches>

