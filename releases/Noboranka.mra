    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Btn 1,Btn 2,-,-,Coin,Start 1P,Start 2P,Pause,-,-" default="A,B,Select,Start,R,L"/>

    <switches default="2F,FF">
        <dip name="Coin A" bits="0,1" ids="2 Coins/1 Credit,1 Coin/3 Credits,1 Coin/2 Credits,1 Coin/1 Credit"/>
        <dip name="Coin B" bits="2,3" ids="2 Coins/1 Credit,1 Coin/3 Credits,1 Coin/2 Credits,1 Coin/1 Credit"/>
        <dip name="Difficulty" bits="4,5" ids="Hardest,Hard,Easy,Medium"/>
        <dip name="Cabinet" bits="6" ids="Upright,Cocktail"/>
        <dip name="Flip Screen" bits="7" ids="Off,On"/>
        <dip name="Lives" bits="8,9" ids="99,5,2,3"/>
        <dip name="Bonus Life" bits="10,11" ids="None,60k+ 120k and 180k,40k+ 80k+ 120k and 160k,50k+ 100k and 150k"/>
        <dip name="Allow Continue" bits="12" ids="No,Yes"/>
        <dip name="Free Play" bits="13" ids="On,Off"/>
    </switches>

