        <dip name="Cabinet" bits="8" ids="Upright,Cocktail"/>
        <dip name="Demo Sounds" bits="9" ids="On,Off"/>
        <dip name="Lives" bits="10,11" ids="Infinite,4,2,3"/>
        <dip name="Bonus Life" bits="12,13" ids="None,100k only,50k and 200k,40k+ 120k and 480k"/>
        <dip name="Reset Timer/Objects On Life Loss" bits="14" ids="Yes,No"/>
        <dip name="SW 0 Read From" bits="15" ids="Port $10,Port $0D"/>
    </switches>

