        <dip name="Cabinet" bits="8" ids="Upright,Cocktail"/>
        <dip name="Lives" bits="10,11" ids="5 (Infinite),4,3,2"/>
        <dip name="Bonus Life" bits="12,13" ids="320000,240000,160000,80000"/>
        <dip name="Difficulty" bits="14" ids="Hard,Easy"/>
        <dip name="SW 0 Read From" bits="15" ids="Port $10,Port $0D"/>
    </switches>

