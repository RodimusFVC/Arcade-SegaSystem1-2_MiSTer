        <dip name="Cabinet" bits="8" ids="Upright,Cocktail"/>
        <dip name="Lives" bits="9,10" ids="Infinite,5,4,3"/>
        <dip name="Ship" bits="11" ids="Multi,Single"/>
        <dip name="Bonus Life" bits="12,13" ids="60k+ then every 70k,50k+ then every 60k,40k+ then every 50k,30k+ then every 40k"/>
        <dip name="Difficulty" bits="14,15" ids="Hardest,Hard,Medium,Easy"/>
    </switches>

