    <buttons names="Btn 1,Btn 2,-,-,Coin,Start 1P,Start 2P,Pause,-,-" default="A,B,Select,Start,R,L"/>

    <switches default="FF,FC">
        <dip name="Coin A" bits="0,3" ids="Unused,1 Coin/1 Credit 2/3,1 Coin/1 Credit 4/5,1 Coin/1 Credit 5/6,2 Coins/1 Credit 4/3,2 Coins/1 Credit 5/3 6/4,2 Coins/3 Credits,4 Coins/1 Credit,3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/6 Credits,1 Coin/5 Credits,1 Coin/4 Credits,1 Coin/3 Credits,1 Coin/2 Credits,1 Coin/1 Credit"/>
