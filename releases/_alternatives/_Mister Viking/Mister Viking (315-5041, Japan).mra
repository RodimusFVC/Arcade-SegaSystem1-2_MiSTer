        <dip name="Cabinet" bits="8" ids="Upright,Cocktail"/>
        <dip name="Lives" bits="10,11" ids="Infinite,5,4,3"/>
        <dip name="Bonus Life" bits="12,13" ids="40k+ then every 30k,30k+ then every 30k,20k+ 40k then every 30k,10k+ 30k then every 30k"/>
        <dip name="Difficulty" bits="15" ids="Hard,Easy"/>
    </switches>

